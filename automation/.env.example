# Токен користувача Slack (починається з xoxp-).
# Отримати: api.slack.com → Your Apps → OAuth & Permissions → User OAuth Token
# Потрібні scopes: channels:history, channels:read, groups:history, groups:read,
#                  im:history, im:read, users:read, reactions:read
SLACK_USER_TOKEN=xoxp-

# Домен воркспейсу — частина URL перед .slack.com
# Наприклад: для mycompany.slack.com → mycompany
SLACK_WORKSPACE_DOMAIN=mycompany

# Канали та DM через кому. Підтримуються назви каналів (без #) та Slack channel ID (C.../D.../G...).
# DM channel ID: відкрити DM у Slack у браузері → скопіювати ID з URL (після /archives/)
# Наприклад: tht-team,D0123456789
SLACK_DEFAULT_CHANNELS=channel1,channel2

# (Застарілий спосіб) Username PM для автоматичного включення DM.
# Краще вказати DM channel ID напряму у SLACK_DEFAULT_CHANNELS.
SLACK_PM_USERNAME=

# Зміщення часового поясу для параметра --date (формат ±HH:MM)
# За замовчуванням: +02:00 (Україна, EET/EEST — влітку UTC+3, але зміщення задається вручну)
SLACK_TZ_OFFSET=+02:00

# Claude API ключ (для майбутнього використання)
ANTHROPIC_API_KEY=
