# Токен користувача Slack (починається з xoxp-).
# Отримати: api.slack.com → Your Apps → OAuth & Permissions → User OAuth Token
# Потрібні scopes: channels:history, channels:read, groups:history, groups:read,
#                  im:history, im:read, users:read, reactions:read, files:read
SLACK_USER_TOKEN=xoxp-

# Домен воркспейсу — частина URL перед .slack.com
# Наприклад: для mycompany.slack.com → mycompany
SLACK_WORKSPACE_DOMAIN=mycompany

# Канали та DM через кому. Підтримуються назви каналів (без #) та Slack channel ID (C.../D.../G...).
# DM channel ID: відкрити DM у Slack у браузері → скопіювати ID з URL (після /archives/)
# Наприклад: tht-team,D0123456789
SLACK_DEFAULT_CHANNELS=channel1,channel2

# (Застарілий спосіб) Username PM для автоматичного включення DM.
# Краще вказати DM channel ID напряму у SLACK_DEFAULT_CHANNELS.
SLACK_PM_USERNAME=

# Зміщення часового поясу для параметра --date (формат ±HH:MM)
# За замовчуванням: +02:00 (Україна, EET/EEST — влітку UTC+3, але зміщення задається вручну)
SLACK_TZ_OFFSET=+02:00

# Claude API ключ (для майбутнього використання)
ANTHROPIC_API_KEY=

# --- Shortcut MCP (команди /shortcut-story, /shortcut-epic) ---

# API-токен Shortcut. Згенерувати: https://app.shortcut.com/settings/account/api-tokens
# MCP-сервер тепер хостед (OAuth) — для авторизації MCP токен НЕ потрібен. Цей токен setup-скрипт
# вписує у .claude/settings.local.json проєкту (gitignored) як env.SHORTCUT_API_TOKEN; команди
# /shortcut-story та /shortcut-epic читають його через $SHORTCUT_API_TOKEN, щоб завантажувати
# прикріплені до сторі/епіка файли через Shortcut REST API (MCP їх не віддає). Токен не йде в git.
SHORTCUT_API_TOKEN=

# ID учасника Shortcut, якого призначати на Frontend-сабтаски (assignee).
# Setup-скрипт вписує це у .claude/settings.local.json проєкту як env.SHORTCUT_MEMBER_ID;
# команда /shortcut-story читає його через $SHORTCUT_MEMBER_ID / $env:SHORTCUT_MEMBER_ID.
SHORTCUT_MEMBER_ID=
