{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "checked", "findings", "resolutions", "open_questions"],
  "properties": {
    "summary": { "type": "string" },
    "checked": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "blocking", "title", "problem", "why", "required_change"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "blocking": { "type": "boolean" },
          "title": { "type": "string" },
          "problem": { "type": "string" },
          "why": { "type": "string" },
          "required_change": { "type": "string" }
        }
      }
    },
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "blocking", "result", "note"],
        "properties": {
          "id": { "type": "string" },
          "blocking": { "type": "boolean" },
          "result": { "type": "string", "enum": ["resolved", "withdrawn", "kept"] },
          "note": { "type": "string" }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
